<?xml version="1.0" encoding="utf-8"?>
<!-- Historia, baza i indeks pozostają lokalne do czasu zaprojektowania świadomego odtwarzania (spec. 10). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
